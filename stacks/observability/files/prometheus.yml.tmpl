# Сгенерировано dock из шаблона стека observability.
# Цели прописаны по именам сервисов compose — они резолвятся внутри сети dock.

global:
  scrape_interval: ${SCRAPE_INTERVAL}
  evaluation_interval: ${SCRAPE_INTERVAL}
  external_labels:
    host: ${DOCK_HOSTNAME}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  # Метрики железа: cpu, память, диски, сеть
  - job_name: node
    static_configs:
      - targets: ['node-exporter:9100']
        labels:
          instance: ${DOCK_HOSTNAME}

  - job_name: grafana
    static_configs:
      - targets: ['grafana:3000']
